{
    "name": "yeriepiscesa/cakephp-crud-connect",
    "description": "Shared CRUD and API base controllers for CakePHP using FriendsOfCake/Crud",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crud",
        "api",
        "friendsofcake"
    ],
    "require": {
        "php": ">=8.4",
        "cakephp/cakephp": "^5.3",
        "friendsofcake/crud": "^7.2",
        "friendsofcake/search": "^7.7"
    },
    "autoload": {
        "psr-4": {
            "CrudConnect\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
